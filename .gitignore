node_modules/
dist/
# build-index writes its temp file beside the target, and the target is ./index.db.
# While it writes, SQLite keeps its journal beside that file (<temp>-journal), and a
# build interrupted mid-write leaves both. The trailing * covers them together.
# index.db itself is committed and must never be ignored.
.tibiawiki.db.*.tmp*
*.log
.DS_Store
